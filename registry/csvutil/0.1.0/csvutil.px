# ============================================================
# 普贤生态库：registry/csvutil — CSV 读写工具
# ------------------------------------------------------------
# 纯函数库，双模式一致。
# 对齐 PHP fgetcsv / Python csv / Go encoding.csv：
#   csv_parse(text, delimiter, quote)    → 解析 CSV 文本 → [[row]]
#   csv_build(rows, delimiter, quote)    → 构建 CSV 文本
#   csv_parse_header(text, delimiter)    → 解析带表头 CSV → [{col: val}]
#   csv_build_header(rows, headers)      → 构建带表头 CSV
#   csv_escape_field(field, delimiter, quote) → 转义字段
#   csv_unescape_field(field)            → 反转义字段
#   csv_filter(rows, column, value)      → 按列过滤
#   csv_sort(rows, column, ascending)    → 按列排序
#   csv_column(rows, column)             → 提取单列
#   csv_unique(rows, column)             → 去重
# ============================================================

# ---- 转义字段 ----
def csv_escape_field(field, delimiter = ",", quote = "\""):
    var needs_quote = false
    if field.contains(delimiter) or field.contains(quote) or field.contains("\n") or field.contains("\r"):
        needs_quote = true
    if needs_quote:
        var escaped = csv_replace_all(field, quote, quote + quote)
        return quote + escaped + quote
    return field

# ---- 辅助：全局替换 ----
def csv_replace_all(text, old, new):
    var result = ""
    var i = 0
    while i < len(text):
        if i + len(old) <= len(text) and text[i : i + len(old)] == old:
            result = result + new
            i = i + len(old)
        else:
            result = result + text[i]
            i += 1
    return result

# ---- 反转义字段 ----
def csv_unescape_field(field, quote = "\""):
    if len(field) >= 2 and field[0] == quote and field[len(field) - 1] == quote:
        var inner = field[1 : len(field) - 1]
        return csv_replace_all(inner, quote + quote, quote)
    return field

# ---- 解析 CSV 文本 ----
def csv_parse(text, delimiter = ",", quote = "\""):
    var rows = []
    var current_row = []
    var current_field = ""
    var in_quote = false
    var i = 0
    while i < len(text):
        var c = text[i]
        if in_quote:
            if c == quote:
                if i + 1 < len(text) and text[i + 1] == quote:
                    current_field = current_field + quote
                    i += 2
                    continue
                else:
                    in_quote = false
                    i += 1
                    continue
            else:
                current_field = current_field + c
                i += 1
                continue
        else:
            if c == quote and len(current_field) == 0:
                in_quote = true
                i += 1
                continue
            elif c == delimiter:
                current_row.append(current_field)
                current_field = ""
                i += 1
                continue
            elif c == "\n":
                current_row.append(current_field)
                current_field = ""
                rows.append(current_row)
                current_row = []
                i += 1
                continue
            elif c == "\r":
                i += 1
                continue
            else:
                current_field = current_field + c
                i += 1
                continue
    # 最后一个字段
    if len(current_field) > 0 or len(current_row) > 0:
        current_row.append(current_field)
        rows.append(current_row)
    return rows

# ---- 构建 CSV 文本 ----
def csv_build(rows, delimiter = ",", quote = "\""):
    var result = ""
    var i = 0
    while i < len(rows):
        var row = rows[i]
        var j = 0
        while j < len(row):
            result = result + csv_escape_field(str(row[j]), delimiter, quote)
            if j < len(row) - 1:
                result = result + delimiter
            j += 1
        result = result + "\n"
        i += 1
    return result

# ---- 解析带表头 CSV ----
def csv_parse_header(text, delimiter = ","):
    var rows = csv_parse(text, delimiter)
    if len(rows) < 1:
        return []
    var headers = rows[0]
    var result = []
    var i = 1
    while i < len(rows):
        var row = rows[i]
        var record = {}
        var j = 0
        while j < len(headers) and j < len(row):
            record[headers[j]] = row[j]
            j += 1
        result.append(record)
        i += 1
    return result

# ---- 构建带表头 CSV ----
def csv_build_header(rows, headers):
    var all_rows = [headers]
    var i = 0
    while i < len(rows):
        var row = []
        var j = 0
        while j < len(headers):
            if rows[i].contains(headers[j]):
                row.append(rows[i][headers[j]])
            else:
                row.append("")
            j += 1
        all_rows.append(row)
        i += 1
    return csv_build(all_rows)

# ---- 按列过滤 ----
def csv_filter(rows, column, value):
    var result = []
    var i = 0
    while i < len(rows):
        if rows[i].contains(column) and rows[i][column] == value:
            result.append(rows[i])
        i += 1
    return result

# ---- 按列排序（简单冒泡） ----
def csv_sort(rows, column, ascending = true):
    var result = []
    var i = 0
    while i < len(rows):
        result.append(rows[i])
        i += 1
    i = 0
    while i < len(result):
        var j = 0
        while j < len(result) - i - 1:
            var swapped = false
            if result[j].contains(column) and result[j + 1].contains(column):
                if ascending:
                    if result[j][column] > result[j + 1][column]:
                        var tmp = result[j]
                        result[j] = result[j + 1]
                        result[j + 1] = tmp
                        swapped = true
                else:
                    if result[j][column] < result[j + 1][column]:
                        var tmp = result[j]
                        result[j] = result[j + 1]
                        result[j + 1] = tmp
                        swapped = true
            j += 1
        i += 1
    return result

# ---- 提取单列 ----
def csv_column(rows, column):
    var result = []
    var i = 0
    while i < len(rows):
        if rows[i].contains(column):
            result.append(rows[i][column])
        i += 1
    return result

# ---- 去重 ----
def csv_unique(rows, column):
    var seen = {}
    var result = []
    var i = 0
    while i < len(rows):
        if rows[i].contains(column):
            var val = rows[i][column]
            if not seen.contains(val):
                seen[val] = true
                result.append(rows[i])
        else:
            result.append(rows[i])
        i += 1
    return result
