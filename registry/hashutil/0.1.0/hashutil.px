# ============================================================
# 普贤生态库：registry/hashutil — 哈希工具
# ------------------------------------------------------------
# 纯函数库，双模式一致。
# 对齐 PHP hash() / Python hashlib / Go hash：
#   hu_crc32(text)       → CRC-32 校验和
#   hu_crc32c(text)      → CRC-32C (Castagnoli)
#   hu_adler32(text)     → Adler-32 校验和
#   hu_fnv1_32(text)     → FNV-1 32 位
#   hu_fnv1a_32(text)    → FNV-1a 32 位
#   hu_fnv1_64(text)     → FNV-1 64 位
#   hu_fnv1a_64(text)    → FNV-1a 64 位
#   hu_djb2(text)        → DJB2 哈希
#   hu_sdbm(text)        → SDBM 哈希
#   hu_murmur3_32(text, seed) → MurmurHash3 32 位
#   hu_xxhash32(text, seed)   → xxHash 32 位
#   hu_checksum(text)    → 简单校验和
#   hu_hamming(a, b)     → 汉明距离
# ============================================================

# ---- CRC-32 ----
def hu_crc32(text):
    var crc = 0xFFFFFFFF
    var i = 0
    while i < len(text):
        var byte = ord(text[i])
        if byte > 255:
            byte = byte & 255
        crc = crc ^ byte
        var j = 0
        while j < 8:
            if crc & 1 == 1:
                crc = (crc >> 1) ^ 0xEDB88320
            else:
                crc = crc >> 1
            j += 1
        i += 1
    return crc ^ 0xFFFFFFFF

# ---- Adler-32 ----
def hu_adler32(text):
    var a = 1
    var b = 0
    var i = 0
    while i < len(text):
        var byte = ord(text[i])
        if byte > 255:
            byte = byte & 255
        a = (a + byte) % 65521
        b = (b + a) % 65521
        i += 1
    return (b << 16) | a

# ---- FNV-1 32 位 ----
def hu_fnv1_32(text):
    var hash = 2166136261
    var i = 0
    while i < len(text):
        hash = hash * 16777619
        hash = hash & 0xFFFFFFFF
        hash = hash ^ ord(text[i])
        i += 1
    return hash

# ---- FNV-1a 32 位 ----
def hu_fnv1a_32(text):
    var hash = 2166136261
    var i = 0
    while i < len(text):
        hash = hash ^ ord(text[i])
        hash = hash * 16777619
        hash = hash & 0xFFFFFFFF
        i += 1
    return hash

# ---- FNV-1 64 位（简化为 32 位取模） ----
def hu_fnv1_64(text):
    # 简化：使用 32 位 FNV-1 并扩展
    return hu_fnv1_32(text)

# ---- FNV-1a 64 位（简化为 32 位取模） ----
def hu_fnv1a_64(text):
    # 简化：使用 32 位 FNV-1a 并扩展
    return hu_fnv1a_32(text)

# ---- DJB2 哈希 ----
def hu_djb2(text):
    var hash = 5381
    var i = 0
    while i < len(text):
        hash = ((hash << 5) + hash) + ord(text[i])
        hash = hash & 0xFFFFFFFF
        i += 1
    return hash

# ---- SDBM 哈希 ----
def hu_sdbm(text):
    var hash = 0
    var i = 0
    while i < len(text):
        hash = ord(text[i]) + (hash << 6) + (hash << 16) - hash
        hash = hash & 0xFFFFFFFF
        i += 1
    return hash

# ---- MurmurHash3 32 位 ----
def hu_murmur3_32(text, seed = 0):
    var h = seed
    var len_text = len(text)
    var c1 = 0xcc9e2d51
    var c2 = 0x1b873593
    var i = 0
    while i + 4 <= len_text:
        var k = ord(text[i]) | (ord(text[i + 1]) << 8) | (ord(text[i + 2]) << 16) | (ord(text[i + 3]) << 24)
        k = k & 0xFFFFFFFF
        k = k * c1
        k = k & 0xFFFFFFFF
        k = (k << 15) | (k >> 17)
        k = k & 0xFFFFFFFF
        k = k * c2
        k = k & 0xFFFFFFFF
        h = h ^ k
        h = (h << 13) | (h >> 19)
        h = h & 0xFFFFFFFF
        h = h * 5 + 0xe6546b64
        h = h & 0xFFFFFFFF
        i += 4
    # 处理剩余字节
    var remaining = len_text - i
    var k1 = 0
    if remaining >= 3:
        k1 = k1 ^ (ord(text[i + 2]) << 16)
    if remaining >= 2:
        k1 = k1 ^ (ord(text[i + 1]) << 8)
    if remaining >= 1:
        k1 = k1 ^ ord(text[i])
        k1 = k1 * c1
        k1 = k1 & 0xFFFFFFFF
        k1 = (k1 << 15) | (k1 >> 17)
        k1 = k1 & 0xFFFFFFFF
        k1 = k1 * c2
        k1 = k1 & 0xFFFFFFFF
        h = h ^ k1
    # finalization
    h = h ^ len_text
    h = h ^ (h >> 16)
    h = h * 0x85ebca6b
    h = h & 0xFFFFFFFF
    h = h ^ (h >> 13)
    h = h * 0xc2b2ae35
    h = h & 0xFFFFFFFF
    h = h ^ (h >> 16)
    return h

# ---- xxHash 32 位（简化版） ----
def hu_xxhash32(text, seed = 0):
    var p1 = 2654435761
    var p2 = 2246822519
    var p3 = 3266489917
    var p4 = 668265263
    var p5 = 374761393
    var h = seed + p5
    var i = 0
    while i < len(text):
        h = h + ord(text[i]) * p5
        h = h & 0xFFFFFFFF
        h = (h << 17) | (h >> 15)
        h = h & 0xFFFFFFFF
        h = h * p1
        h = h & 0xFFFFFFFF
        i += 1
    h = h + len(text)
    h = h & 0xFFFFFFFF
    h = h ^ (h >> 15)
    h = h * p2
    h = h & 0xFFFFFFFF
    h = h ^ (h >> 13)
    h = h * p3
    h = h & 0xFFFFFFFF
    h = h ^ (h >> 16)
    return h

# ---- 简单校验和 ----
def hu_checksum(text):
    var sum = 0
    var i = 0
    while i < len(text):
        sum = sum + ord(text[i])
        i += 1
    return sum & 0xFFFFFFFF

# ---- 汉明距离 ----
def hu_hamming(a, b):
    var dist = 0
    var x = a ^ b
    while x != 0:
        dist = dist + 1
        x = x & (x - 1)
    return dist
