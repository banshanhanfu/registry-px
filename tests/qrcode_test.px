# qrcode.px 测试：双模式一致；矩阵与 Python segno 1.6.6 对拍（golden）
import "../registry/qrcode/0.1.0/qrcode.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def matrix_eq(a, b):
    if len(a) != len(b):
        return false
    var i = 0
    while i < len(a):
        if len(a[i]) != len(b[i]):
            return false
        var j = 0
        while j < len(a[i]):
            if a[i][j] != b[i][j]:
                return false
            j += 1
        i += 1
    return true
# 把 golden 行串转成矩阵
def rows_to_matrix(rows):
    var out = []
    var i = 0
    while i < len(rows):
        var line = rows[i]
        var row = []
        var j = 0
        while j < len(line):
            row.append(line[j] == "1")
            j += 1
        out.append(row)
        i += 1
    return out
def contains(s, sub):
    var i = 0
    while i + len(sub) <= len(s):
        var j = 0
        var hit = true
        while j < len(sub):
            if s[i + j] != sub[j]:
                hit = false
                break
            j += 1
        if hit:
            return true
        i += 1
    return false
def main():
    # ---- golden 1: "A" / L / v1（与 segno mask3 逐位一致） ----
    var g1 = [
        "111111101011101111111",
        "100000100011001000001",
        "101110101101001011101",
        "101110101100101011101",
        "101110101001001011101",
        "100000100111101000001",
        "111111101010101111111",
        "000000000001100000000",
        "111100101111110011101",
        "101101000011111001000",
        "100100100001000001101",
        "010110011001001111110",
        "110101100010100100110",
        "000000001001001001011",
        "111111100011100101011",
        "100000100110000110100",
        "101110100010111110001",
        "101110101011001111110",
        "101110101000101100000",
        "100000101110010100100",
        "111111101110010010010",
    ]
    var r1 = qrcode_encode_at("A", "L", 1, -1)
    expect(r1.is_ok(), "encode A/L/v1")
    var m1 = r1.unwrap()[2]
    expect(matrix_eq(m1, rows_to_matrix(g1)), "golden A L v1")
    expect(qrcode_version(m1) == 1, "version of matrix")
    # ---- golden 2: "HELLO WORLD" / Q / v2（与 segno mask7 逐位一致；alnum 模式） ----
    var g2 = [
        "1111111011011010001111111",
        "1000001001101000101000001",
        "1011101011100011001011101",
        "1011101010011100101011101",
        "1011101001000000001011101",
        "1000001011001001101000001",
        "1111111010101010101111111",
        "0000000011001101100000000",
        "0101011110101010111101101",
        "0010110001100101110010110",
        "0001001101000111001101000",
        "0111110010010100110001011",
        "0110001011010011001011111",
        "0011010100100011100000101",
        "1010111100010000000001010",
        "0100100110000001011001010",
        "1110101110000110111110101",
        "0000000010001001100010111",
        "1111111011011010101011100",
        "1000001010110110100010000",
        "1011101000001001111110101",
        "1011101010110011101010010",
        "1011101001001101101110001",
        "1000001010100010000110101",
        "1111111000001000111111101",
    ]
    var r2 = qrcode_encode_at("HELLO WORLD", "Q", 2, -1)
    expect(r2.is_ok(), "encode HELLO/Q/v2")
    expect(matrix_eq(r2.unwrap()[2], rows_to_matrix(g2)), "golden HELLO WORLD Q v2")
    # ---- golden 3: "1234567890" / L / v2（与 segno mask5 逐位一致；numeric 模式） ----
    var g3 = [
        "1111111000011001101111111",
        "1000001001100110101000001",
        "1011101000001101001011101",
        "1011101010001000101011101",
        "1011101011000001101011101",
        "1000001000011001001000001",
        "1111111010101010101111111",
        "0000000000110011100000000",
        "1100011101010000100011000",
        "1110010111001100111010100",
        "0011111010100111110100101",
        "1110010111001100000000010",
        "0101011001011101100110101",
        "1101000010000000101111010",
        "1000101000011000001010000",
        "1001110110010001011100110",
        "1010101110110000111111011",
        "0000000011001111100010001",
        "1111111010110001101011110",
        "1000001010101100100010000",
        "1011101000001011111111001",
        "1011101000000011101111001",
        "1011101000011001011001101",
        "1000001011110010010101111",
        "1111111011000110010111111",
    ]
    var r3 = qrcode_encode_at("1234567890", "L", 2, -1)
    expect(r3.is_ok(), "encode 123/L/v2")
    expect(matrix_eq(r3.unwrap()[2], rows_to_matrix(g3)), "golden 1234567890 L v2")
    # ---- 自动选择：短内容 → v1，掩码为 0..7 之一 ----
    var ra = qrcode_encode("x", "L")
    expect(ra.is_ok(), "auto encode")
    var aa = ra.unwrap()
    expect(aa[0] == 1, "auto version 1")
    expect(aa[1] >= 0 and aa[1] <= 7, "auto mask in 0..7")
    expect(qrcode_version(aa[2]) == 1, "auto matrix v1")
    # ---- 容量边界：超出 v1-10 → Err ----
    var big = "Q" * 500
    var rb = qrcode_encode(big, "L")
    expect(rb.is_err(), "overflow err")
    # ---- 非法纠错级 -> Err ----
    var re = qrcode_encode("x", "Z")
    expect(re.is_err(), "bad ec err")
    # ---- 输出函数 ----
    var asc = qrcode_ascii(m1)
    expect(contains(asc, "██"), "ascii has block")
    var rows_asc = asc.split("\n")
    expect(len(rows_asc) - 1 == 21 + 8, "ascii rows incl quiet")
    var pbm = qrcode_pbm(m1, 4)
    expect(pbm[0:2] == "P1", "pbm header")
    var pbm_lines = pbm.split("\n")
    expect(pbm_lines[1] == "29 29", "pbm size 29x29")
    var pbm_rows = pbm.split("\n")
    expect(len(pbm_rows) == 32, "pbm row count (2 header + 29 rows + trailing empty)")
    print("qrcode: PASS")
