# jwt.px 0.2.0 测试：双模式一致（HS256 + RS256）
import "../registry/jwt/0.2.0/jwt.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    # ---- HS256 原有测试（向后兼容）----
    var payload = {"sub": "1234567890", "name": "John Doe", "iat": 1516239022}
    var secret = "your-256-bit-secret"
    var r = jwt_encode(payload, secret)
    expect(r.is_ok(), "HS256 encode ok")
    var token = r.unwrap()
    var d = jwt_decode(token, secret)
    expect(d.is_ok(), "HS256 decode ok")
    expect(d.unwrap()["payload"]["sub"] == "1234567890", "HS256 payload sub")
    # 篡改签名
    var bad = token[0:len(token)-4] + "AAAA"
    expect(jwt_decode(bad, secret).is_err(), "HS256 篡改签名失败")
    # 过期
    var exp_payload = {"sub": "x", "exp": 1000}
    var r2 = jwt_encode(exp_payload, secret)
    expect(jwt_decode(r2.unwrap(), secret).is_err(), "HS256 过期 token")
    # jwt_decode_at with future now
    expect(jwt_decode_at(r2.unwrap(), secret, 999).is_ok(), "HS256 未过期 at 999")

    # ---- RS256 测试（0.2.0 新增）----
    var pem_priv = "-----BEGIN RSA PRIVATE KEY-----\nMIICXQIBAAKBgQDTTV5G2LESDU82mq3E3nw7wWdYh0tGhOi5Avq+Cz1MIksUfGHc\n1vhegV+Q8dGaW4GmK/pnHQ2YI5/7hlxW3G6McE6cxHPuQdiNNS+dau8B9BqI/3FD\nE+acTpjd4KdDSDtLuv4jQUsBz5hzI9ZzjKkNKAMNSrcmqAQA5Q/BDQvUGQIDAQAB\nAoGBAKNNAtRr+YUDBjokFrG0ZHzl/pG7leB9LUJ23APtucTSKAZADn3XIYIgKBRj\n3uKVX8Bl8pKoMG5o8eY4s7pph4DXbUv/l0Z4vkxkr47nGapSkUFhGuY+kHIiioMz\nk1dSroShjZhbb3EzmXprp7cw866PeWO0nPMhkYts+TiWgSEVAkEA+voner5vWZT/\nfe+fUtZr8lSuexHs928GVuqcCOVgnXp2UkD9yfLqTs8jb/IdR/HrL9h4JgK65a2q\nCnHAPzLNBwJBANeH8fM3f94V4u2MsKRu9+34zVk7U70ENzpewggqZUhUcMkw0li1\n33RmUN1SdoCBIk6oSh2uT7wls2wuM8D3Ld8CQE5bPWov/Hm+cAn0fwyQz0DoOVVJ\nIm+Z5SPLuY15d7GS41AI5HNheM/EEe9IauXkXKYicliDr7A3iQgbvYa9qI8CQQCn\nqFSJwc5xz8yqxRpTjw7FyxjSJNhK3JCpkzSUbYZD8YuataOq5i9guIaG47LS26D4\nVujwlbvou9sKeBZCMQU5AkBPNLuCLv/YEODbpj+5VvKnOB8n/r6e+37dbCSTTQ1L\nWq0q+Hs/drUJMlHz0Xl85QLaSUymyeQpRr4Nm7zFBIy0\n-----END RSA PRIVATE KEY-----"
    var pem_pub = "-----BEGIN PUBLIC KEY-----\nMIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDTTV5G2LESDU82mq3E3nw7wWdY\nh0tGhOi5Avq+Cz1MIksUfGHc1vhegV+Q8dGaW4GmK/pnHQ2YI5/7hlxW3G6McE6c\nxHPuQdiNNS+dau8B9BqI/3FDE+acTpjd4KdDSDtLuv4jQUsBz5hzI9ZzjKkNKAMN\nSrcmqAQA5Q/BDQvUGQIDAQAB\n-----END PUBLIC KEY-----"

    # 1. 用 jwt_encode_v2 生成 RS256 token
    var r3 = jwt_encode_v2(payload, pem_priv, "RS256")
    expect(r3.is_ok(), "RS256 encode ok: " + str(r3))
    var rs_token = r3.unwrap()
    # 验证 header 是 RS256
    var parts = split(rs_token, ".")
    expect(len(parts) == 3, "RS256 3 段")
    var hdr_r = jwt_b64url_decode(parts[0])
    var hdr_j = json_parse_opt(hdr_r.unwrap())
    expect(str(hdr_j.unwrap()["alg"]) == "RS256", "RS256 header alg")

    # 2. 用 jwt_decode_v2 验证（公钥）
    var d2 = jwt_decode_v2(rs_token, pem_pub)
    expect(d2.is_ok(), "RS256 decode ok: " + str(d2))
    expect(d2.unwrap()["payload"]["name"] == "John Doe", "RS256 payload name")

    # 3. 篡改签名 -> 失败
    var rs_bad = rs_token[0:len(rs_token)-4] + "AAAA"
    expect(jwt_decode_v2(rs_bad, pem_pub).is_err(), "RS256 篡改签名失败")

    # 4. 假签名 -> 失败
    var rs_bad2 = parts[0] + "." + parts[1] + ".AAAA"
    expect(jwt_decode_v2(rs_bad2, pem_pub).is_err(), "RS256 假签名失败")

    # 5. 交叉验证：openssl 生成的 token 用 PuXian 验证
    var openssl_token = "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.cImMO87r8x5q6C5wZosMhBnV6C4CnZt60vr_zeGS6iIZfaJopUcOjXA4BP0_XYBx1jQ8FpHnCv5sK-MopkVHuqvxb21pk8Wig56U30NKA9_sC7FXobuNJiw8bFm_TJ3xBgkJIF1bUG3zSJH9Qh4fscJhNjNkHC-7BQyn8B46uEY"
    var d3 = jwt_decode_v2(openssl_token, pem_pub)
    expect(d3.is_ok(), "RS256 openssl token 验证 ok: " + str(d3))
    expect(d3.unwrap()["payload"]["sub"] == "1234567890", "RS256 openssl payload sub")

    # 6. HS256 向后兼容：jwt_encode_v2 也支持 HS256
    var r4 = jwt_encode_v2(payload, secret, "HS256")
    expect(r4.is_ok(), "v2 HS256 encode ok")
    expect(jwt_decode_v2(r4.unwrap(), secret).is_ok(), "v2 HS256 decode ok")

    # 7. 不支持的算法
    expect(jwt_encode_v2(payload, secret, "ES256").is_err(), "ES256 不支持")

    print("jwt 0.2.0: PASS")
