# protobuf 0.2.0 测试
import "../registry/protobuf/0.2.0/protobuf.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    # ---- 0.1.0 回归（schema 为 dict，键为字段号字符串）----
    var schema = {
        "1": {"fno": 1, "name": "x", "type": "varint"},
        "2": {"fno": 2, "name": "y", "type": "bytes"}
    }
    var obj = {"1": 150, "2": bytes("abc")}
    var r = pb_encode(schema, obj)
    expect(r.is_ok(), "encode ok")
    var data = r.unwrap()
    expect(len(data) > 0, "encode non-empty")
    var dr = pb_decode(schema, data)
    expect(dr.is_ok(), "decode ok")
    var decoded = dr.unwrap()
    expect(decoded["1"] == 150, "decode x=150: " + str(decoded["1"]))
    # ---- 0.2.0 encode_field ----
    var f = pb_encode_field(1, "varint", 42)
    expect(len(f) > 0, "encode_field non-empty")
    # ---- 0.2.0 size ----
    var sz = pb_size(schema, obj)
    expect(sz == len(data), "size matches: " + str(sz) + " vs " + str(len(data)))
    print("PASS: protobuf 0.2.0")
