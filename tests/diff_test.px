# diff.px 0.2.0 测试：双模式一致（行级 + 字符级 inline diff）
import "../registry/diff/0.2.0/diff.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    # ---- 行级 diff 原有测试 ----
    var a = "hello\nworld\nfoo"
    var b = "hello\nearth\nfoo\nbar"
    var lines = df_lines(a, b)
    expect(lines[0] == " hello", "行1 共有")
    expect(lines[1] == "-world", "行2 删除")
    expect(lines[2] == "+earth", "行3 新增")
    expect(lines[3] == " foo", "行4 共有")
    expect(lines[4] == "+bar", "行5 新增")
    var ratio = df_ratio(a, b)
    expect(ratio > 0.0 and ratio < 1.0, "ratio 0<r<1: " + str(ratio))
    expect(df_ratio("abc", "abc") == 1.0, "ratio 相同=1")
    expect(df_ratio("", "") == 1.0, "ratio 空=1")
    expect(df_ratio("abc", "xyz") == 0.0, "ratio 完全不同=0")

    # ---- 字符级 opcodes（0.2.0 新增）----
    # "abc" vs "axc" → equal(a), replace(b→x), equal(c)
    var ops = df_opcodes("abc", "axc")
    expect(len(ops) == 3, "opcodes 3 段: " + str(len(ops)))
    expect(ops[0]["tag"] == "equal", "op0 equal")
    expect(ops[1]["tag"] == "replace", "op1 replace")
    expect(ops[2]["tag"] == "equal", "op2 equal")
    expect(ops[0]["a1"] == 0 and ops[0]["a2"] == 1, "op0 a[0:1]")
    expect(ops[1]["a1"] == 1 and ops[1]["a2"] == 2, "op1 a[1:2]")
    expect(ops[1]["b1"] == 1 and ops[1]["b2"] == 2, "op1 b[1:2]")

    # 全等
    var ops2 = df_opcodes("hello", "hello")
    expect(len(ops2) == 1 and ops2[0]["tag"] == "equal", "全等 1 equal")

    # 纯插入
    var ops3 = df_opcodes("ac", "abc")
    expect(len(ops3) == 3, "插入 3 段: " + str(len(ops3)))
    expect(ops3[1]["tag"] == "insert", "op1 insert")

    # 纯删除
    var ops4 = df_opcodes("abc", "ac")
    expect(len(ops4) == 3, "删除 3 段: " + str(len(ops4)))
    expect(ops4[1]["tag"] == "delete", "op1 delete")

    # ---- inline diff 可读格式 ----
    var inline1 = df_inline("abc", "axc")
    expect(inline1 == "a[-b-]{+x+}c", "inline replace: " + inline1)

    var inline2 = df_inline("ac", "abc")
    expect(inline2 == "a{+b+}c", "inline insert: " + inline2)

    var inline3 = df_inline("abc", "ac")
    expect(inline3 == "a[-b-]c", "inline delete: " + inline3)

    var inline4 = df_inline("hello", "hello")
    expect(inline4 == "hello", "inline 全等: " + inline4)

    var inline5 = df_inline("", "abc")
    expect(inline5 == "{+abc+}", "inline 空→abc: " + inline5)

    var inline6 = df_inline("abc", "")
    expect(inline6 == "[-abc-]", "inline abc→空: " + inline6)

    # 实际场景：函数重命名
    var inline7 = df_inline("def foo(x):", "def bar(x):")
    expect(contains(inline7, "[-foo-]"), "inline 重命名含 foo 删除")
    expect(contains(inline7, "{+bar+}"), "inline 重命名含 bar 新增")

    # ---- unified diff ----
    var uni = df_unified(a, b)
    expect(contains(uni, "--- a"), "unified 有 --- a")
    expect(contains(uni, "+++ b"), "unified 有 +++ b")
    expect(contains(uni, "@@"), "unified 有 @@ 头")
    expect(contains(uni, "-world"), "unified 有 -world")
    expect(contains(uni, "+earth"), "unified 有 +earth")

    # 完全相同 → 无变更行
    var uni2 = df_unified("same\nlines", "same\nlines")
    expect(contains(uni2, "--- a"), "unified 相同也有头")

    print("diff 0.2.0: PASS")
