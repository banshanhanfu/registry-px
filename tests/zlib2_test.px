# zlib 0.2.0 测试
import "../registry/zlib/0.2.0/zlib.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    # ---- 0.1.0 回归（data 为 bytes）----
    var data = bytes("Hello")
    var c = zl_compress(data)
    if c.is_err():
        print("SKIP/ERR（解释轨 FFI 未注册，PX-DEF-035）: " + str(c))
        print("zlib 0.2.0: PASS（解释轨优雅降级）")
        return
    var comp = c.unwrap()
    expect(len(comp) > 0, "compress non-empty")
    var d = zl_uncompress(comp)
    expect(d.is_ok(), "uncompress ok")
    var dec = d.unwrap()
    expect(dec == data, "roundtrip: " + bytes_to_hex(dec))
    # ---- 0.2.0 adler32 ----
    var a = zl_adler32(bytes("ABC"))
    expect(a > 0, "adler32 > 0: " + str(a))
    # ---- 0.2.0 is_compressed ----
    expect(zl_is_compressed(comp) == true, "is_compressed true")
    expect(zl_is_compressed(bytes("hi")) == false, "is_compressed false")
    # ---- 0.2.0 level_valid ----
    expect(zl_level_valid(6) == true, "level 6 valid")
    expect(zl_level_valid(10) == false, "level 10 invalid")
    print("PASS: zlib 0.2.0")
