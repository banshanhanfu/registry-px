# csvutil 0.1.0 测试
import "../registry/csvutil/0.1.0/csvutil.px"

def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)

def main():
    # 基本解析
    var rows = csv_parse("a,b,c\n1,2,3\n4,5,6\n")
    expect(len(rows) == 3, "parse rows: " + str(len(rows)))
    expect(rows[0][0] == "a", "parse r0c0: " + rows[0][0])
    expect(rows[1][1] == "2", "parse r1c1: " + rows[1][1])
    expect(rows[2][2] == "6", "parse r2c2: " + rows[2][2])
    # 带引号
    rows = csv_parse("\"hello,world\",b\n\"quoted\"\"field\",d\n")
    expect(rows[0][0] == "hello,world", "parse quoted comma: " + rows[0][0])
    expect(rows[1][0] == "quoted\"field", "parse quoted quote: " + rows[1][0])
    # 构建
    var text = csv_build([["a", "b", "c"], ["1", "2", "3"]])
    expect(text == "a,b,c\n1,2,3\n", "build: " + text)
    # 构建带转义
    text = csv_build([["hello,world", "b"], ["c", "d\"]"]])
    expect(text.contains("\"hello,world\""), "build escape comma: " + text)
    expect(text.contains("d\"\""), "build escape quote: " + text)
    # 往返
    var orig_rows = [["a", "b,c", "d\"e"], ["1", "2", "3"]]
    var built = csv_build(orig_rows)
    var parsed = csv_parse(built)
    expect(len(parsed) == 2, "roundtrip rows: " + str(len(parsed)))
    expect(parsed[0][1] == "b,c", "roundtrip comma: " + parsed[0][1])
    expect(parsed[0][2] == "d\"e", "roundtrip quote: " + parsed[0][2])
    # 带表头
    var csv_text = "name,age,city\nAlice,30,NYC\nBob,25,LA\n"
    var records = csv_parse_header(csv_text)
    expect(len(records) == 2, "header records: " + str(len(records)))
    expect(records[0]["name"] == "Alice", "header r0 name: " + records[0]["name"])
    expect(records[0]["age"] == "30", "header r0 age: " + records[0]["age"])
    expect(records[1]["city"] == "LA", "header r1 city: " + records[1]["city"])
    # 构建带表头
    var built_header = csv_build_header([{"name": "X", "age": "20", "city": "SF"}], ["name", "age", "city"])
    expect(built_header.contains("name,age,city"), "build header: " + built_header)
    expect(built_header.contains("X,20,SF"), "build header data: " + built_header)
    # 过滤
    var filtered = csv_filter(records, "city", "LA")
    expect(len(filtered) == 1, "filter: " + str(len(filtered)))
    expect(filtered[0]["name"] == "Bob", "filter name: " + filtered[0]["name"])
    # 排序
    var sorted = csv_sort(records, "age", true)
    expect(sorted[0]["age"] == "25", "sort asc: " + sorted[0]["age"])
    var sorted_desc = csv_sort(records, "age", false)
    expect(sorted_desc[0]["age"] == "30", "sort desc: " + sorted_desc[0]["age"])
    # 提取列
    var col = csv_column(records, "name")
    expect(len(col) == 2, "column len: " + str(len(col)))
    expect(col[0] == "Alice", "column 0: " + col[0])
    # 去重
    var dup_records = [{"name": "A", "city": "X"}, {"name": "B", "city": "X"}, {"name": "C", "city": "Y"}]
    var unique = csv_unique(dup_records, "city")
    expect(len(unique) == 2, "unique: " + str(len(unique)))
    print("csvutil: PASS")
